{
  "seed": 42,
  "images": "data/zenodo/Images",
  "records": "data/processed/zenodo/first-step-supplement/images.jsonl",
  "split_manifest": "outputs/experiments/resnet18-zenodo-sysu/inputs/zenodo_split_manifest.json",
  "backbone": "resnet18_fpn",
  "class_weighting": "balanced",
  "views": "global",
  "epochs": 50,
  "patience": 8,
  "batch_size": 4,
  "workers": 2,
  "encoder_lr": 0.0001,
  "head_lr": 0.001,
  "weight_decay": 0.0001,
  "selection": [
    "accuracy",
    "macro_f1",
    "earlier_epoch"
  ],
  "auxiliary_classification_weight": 0.5,
  "preprocessing": {
    "input_size": 224,
    "resize": "aspect_preserving_pad",
    "interpolation": "bilinear",
    "padding_rgb": [
      124,
      116,
      104
    ],
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ]
  },
  "device": "cuda",
  "tf32": false,
  "cudnn_deterministic": true,
  "min_size": 512,
  "max_size": 1024,
  "detection_weight": 1.0,
  "box_score_thresh": 0.001,
  "box_nms_thresh": 0.5,
  "display_thresh": 0.5,
  "detections_per_image": 100,
  "rotation_degrees": 0
}